# Copy this file to `.env` in the project folder and fill in your values.
# `.env` is git-ignored; never commit it. Real environment variables override it.

# OpenSky API client (Account page on opensky-network.org -> API client).
# Copy clientId and clientSecret from the credentials.json OpenSky gave you.
# Alternatively, leave these empty and put credentials.json itself in the project folder.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional: Django secret key for the /admin console. If unset, one is generated
# once and kept in alerts.admin.sqlite.secret.
# AEROSCAN_SECRET_KEY=

# Optional: where `aeroscan fetch-data` keeps the evaluation datasets (default: data).
# AEROSCAN_DATA=data
